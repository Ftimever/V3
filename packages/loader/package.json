{
  "name": "@easybot/loader",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@easybot/contracts": "workspace:*",
    "@easybot/core": "workspace:*",
    "@easybot/runtime-process": "workspace:*",
    "ajv": "8.17.1",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.7.1"
  }
}
