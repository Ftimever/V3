{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:easybot:schema:plugin-manifest:v1",
  "title": "Plugin Manifest",
  "type": "object",
  "required": ["schemaVersion", "pluginId", "displayName", "runtime"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "pluginId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "documentation": { "type": "string" },
    "runtime": {
      "type": "object",
      "required": ["kind", "entry"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["in-process", "child-process"] },
        "entry": { "type": "string", "pattern": "^\\./", "minLength": 3 },
        "protocolVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventReference" } }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugins": { "$ref": "#/$defs/pluginDependencies" },
        "services": { "$ref": "#/$defs/serviceDependencies" },
        "capabilities": { "$ref": "#/$defs/capabilityDependencies" }
      }
    },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restart": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxAttempts": { "type": "integer", "minimum": 0 },
            "backoff": { "enum": ["fixed", "linear", "exponential"] },
            "delayMs": { "type": "integer", "minimum": 0 },
            "maxDelayMs": { "type": "integer", "minimum": 0 }
          }
        },
        "requiredDependencyFailure": { "const": "stop" },
        "optionalDependencyFailure": { "enum": ["stop", "degraded"] }
      }
    },
    "config": { "$ref": "#/$defs/config" },
    "webui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "route"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "route": { "type": "string", "pattern": "^/" },
              "icon": { "type": "string" }
            }
          }
        },
        "config": { "$ref": "#/$defs/config" },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "component"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "component": { "enum": ["status-card", "log-panel", "info-card"] },
              "title": { "type": "string" },
              "props": { "$ref": "#/$defs/jsonObject" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "eventReference": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "delivery": { "enum": ["parallel", "serial", "pipeline"] },
        "retryable": { "type": "boolean" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "methods": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$", "not": { "enum": ["constructor", "prototype", "then"] } } },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      }
    },
    "pluginDependency": {
      "type": "object",
      "required": ["pluginId", "version"],
      "additionalProperties": false,
      "properties": {
        "pluginId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "serviceDependency": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "capabilityDependency": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "pluginDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/$defs/pluginDependency" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/pluginDependency" } }
      }
    },
    "serviceDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/$defs/serviceDependency" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/serviceDependency" } }
      }
    },
    "capabilityDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/$defs/capabilityDependency" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/capabilityDependency" } }
      }
    },
    "permission": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(process|network|filesystem|storage|service|event|webui|secret):.+$" },
        "reason": { "type": "string" },
        "scope": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "config": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "x-reload": { "enum": ["hot", "reconnect", "restart", "manual"] } }
          }
        }
      }
    },
    "json": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
  }
}
